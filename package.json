{
  "name": "klikmed-pharmacy-tests",
  "version": "1.0.0",
  "description": "Playwright tests for the KlikMed HMIS pharmacy module",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "test:e2e-modules": "playwright test --project=e2e-modules",
    "test:e2e": "playwright test --project=e2e",
    "qa:data": "tsx scripts/qa/build-test-data.ts",
    "qa:inventory": "tsx scripts/qa/build-inventory.ts",
    "typecheck": "tsc --noEmit -p .",
    "qa:e2e-workbook": "tsx scripts/qa/build-e2e-workbook.ts",
    "qa:e2e-chains": "tsx scripts/qa/build-e2e-chains.ts",
    "test:prereq": "playwright test --project=prereq",
    "qa:prereq-evidence": "tsx scripts/qa/build-prereq-evidence.ts",
    "qa:run-summary": "tsx scripts/qa/build-run-summary.ts",
    "qa:messages": "tsx scripts/qa/fetch-messages.ts",
    "qa:findings-md": "tsx scripts/qa/build-findings-md.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "exceljs": "^4.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^3.25.76"
  }
}
